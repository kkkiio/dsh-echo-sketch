{
  "name": "dsh-echo-sketch",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin that bridges human-agent communication through a dual-canvas sketchpad.",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/index.js && node --check dist/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
      "node": ">=22.19",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "concurrently": "9.1.2",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sketch",
    "canvas"
  ]
}
